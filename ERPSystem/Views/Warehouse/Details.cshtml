@model ERPSystem.Models.Warehouse

<h2>Warehouse Details</h2>

<hr/>

<dl class="row">

    <dt class="col-sm-2">
        Name
    </dt>

    <dd class="col-sm-10">
        @Model.Name
    </dd>

    <dt class="col-sm-2">
        Address
    </dt>

    <dd class="col-sm-10">
        @Model.Address
    </dd>

</dl>

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>