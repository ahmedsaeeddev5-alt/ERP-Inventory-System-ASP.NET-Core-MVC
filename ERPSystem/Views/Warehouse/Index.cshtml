@model IEnumerable<ERPSystem.Models.Warehouse>

@{
    ViewData["Title"] = "Warehouses";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Warehouses</h2>

        <a asp-action="New" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add Warehouse
        </a>
    </div>

    <form method="get" asp-action="Index" class="row mb-3">
        <div class="col-md-4">
            <input type="text"
                   class="form-control"
                   name="search"
                   value="@ViewBag.Search"
                   placeholder="Search..." />
        </div>

        <div class="col-md-2">
            <button class="btn btn-primary">
                Search
            </button>
        </div>
    </form>

    @if (TempData["SuccessData"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessData"]
        </div>
    }

    <table class="table table-bordered table-striped">

        <thead>

            <tr>

                <th>Name</th>

                <th>Address</th>

                <th width="250">Actions</th>

            </tr>

        </thead>

        <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Name</td>

                <td>@item.Address</td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Details
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>

                </td>

            </tr>
        }

        </tbody>

    </table>

</div>