@model ERPSystem.Models.SalesInvoice

@{
    ViewData["Title"] = "Invoice Details";
}


<div class="container mt-4">

    <h2>Sales Invoice Details</h2>

    <hr />


    <!-- Invoice Header -->
    <div class="card mb-3">

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Invoice Number
                </dt>

                <dd class="col-sm-9">
                    @Model.InvoiceNumber
                </dd>


                <dt class="col-sm-3">
                    Date
                </dt>

                <dd class="col-sm-9">
                    @Model.InvoiceDate.ToString("yyyy-MM-dd")
                </dd>


                <dt class="col-sm-3">
                    Customer
                </dt>

                <dd class="col-sm-9">
                    @Model.Customer?.Name
                </dd>


                <dt class="col-sm-3">
                    Total Amount
                </dt>

                <dd class="col-sm-9">
                    @Model.TotalAmount.ToString("N2")
                </dd>

            </dl>

        </div>

    </div>



    <!-- Invoice Items -->
    <h4>Products</h4>


    <table class="table table-bordered table-striped">

        <thead class="table-dark">

            <tr>

                <th>
                    Product
                </th>

                <th>
                    Quantity
                </th>

                <th>
                    Unit Price
                </th>

                <th>
                    Total
                </th>

            </tr>

        </thead>


        <tbody>

            @foreach (var item in Model.Items)
            {
                <tr>

                    <td>
                        @item.Product?.Name
                    </td>


                    <td>
                        @item.Quantity
                    </td>


                    <td>
                        @item.UnitPrice.ToString("N2")
                    </td>


                    <td>
                        @item.Total.ToString("N2")
                    </td>

                </tr>
            }

        </tbody>


    </table>



    <div class="mt-3">

        <a asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>


        <button onclick="window.print()"
                class="btn btn-primary">
            Print
        </button>

    </div>


</div>