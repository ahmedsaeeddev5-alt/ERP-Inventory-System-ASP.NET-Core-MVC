@model IEnumerable<ERPSystem.Models.SalesInvoice>

@{
    ViewData["Title"] = "Sales Invoices";
}


<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Sales Invoices</h2>


        <a asp-action="New" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            New Invoice
        </a>

    </div>



    <table class="table table-bordered table-striped">

        <thead class="table-dark">

            <tr>

                <th>
                    Invoice Number
                </th>

                <th>
                    Date
                </th>

                <th>
                    Customer
                </th>

                <th>
                    Total Amount
                </th>

                <th>
                    Actions
                </th>

            </tr>

        </thead>


        <tbody>

            @foreach (var invoice in Model)
            {
                <tr>

                    <td>
                        @invoice.InvoiceNumber
                    </td>


                    <td>
                        @invoice.InvoiceDate.ToString("yyyy-MM-dd")
                    </td>


                    <td>
                        @invoice.Customer?.Name
                    </td>


                    <td>
                        @invoice.TotalAmount.ToString("N2")$
                    </td>


                    <td>

                        <a asp-action="Details"
                           asp-route-id="@invoice.Id"
                           class="btn btn-info btn-sm">
                            Details
                        </a>


                        <a asp-action="Delete"
                           asp-route-id="@invoice.Id"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>


    </table>


</div>