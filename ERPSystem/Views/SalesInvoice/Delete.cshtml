@model ERPSystem.Models.SalesInvoice

@{
    ViewData["Title"] = "Delete Sales Invoice";
}


<div class="container mt-4">

    <h2>Delete Sales Invoice</h2>

    <hr />


    <div class="alert alert-danger">
        Are you sure you want to delete this invoice?
    </div>



    <div class="card">

        <div class="card-body">


            <dl class="row">


                <dt class="col-sm-3">
                    Invoice Number
                </dt>

                <dd class="col-sm-9">
                    @Model.InvoiceNumber
                </dd>



                <dt class="col-sm-3">
                    Date
                </dt>

                <dd class="col-sm-9">
                    @Model.InvoiceDate.ToString("yyyy-MM-dd")
                </dd>



                <dt class="col-sm-3">
                    Customer
                </dt>

                <dd class="col-sm-9">
                    @Model.Customer?.Name
                </dd>



                <dt class="col-sm-3">
                    Total Amount
                </dt>

                <dd class="col-sm-9">
                    @Model.TotalAmount.ToString("N2")
                </dd>


            </dl>


        </div>

    </div>




    <form asp-action="Delete" method="post" class="mt-3">


        <input type="hidden" asp-for="Id" />


        <button type="submit"
                class="btn btn-danger">

            Delete

        </button>



        <a asp-action="Index"
           class="btn btn-secondary">

            Cancel

        </a>


    </form>


</div>