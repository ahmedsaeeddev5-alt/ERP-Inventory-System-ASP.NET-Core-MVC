@model ERPSystem.ViewModels.Dashboard.DashboardVM


<h2 class="mb-4">Dashboard</h2>


<div class="row">


    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">

                <h5>Products</h5>

                <h3>@Model.ProductsCount</h3>

            </div>
        </div>
    </div>



    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">

                <h5>Customers</h5>

                <h3>@Model.CustomersCount</h3>

            </div>
        </div>
    </div>



    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">

                <h5>Suppliers</h5>

                <h3>@Model.SuppliersCount</h3>

            </div>
        </div>
    </div>



    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">

                <h5>Sales Invoices</h5>

                <h3>@Model.SalesInvoicesCount</h3>

            </div>
        </div>
    </div>



    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">

                <h5>Purchase Invoices</h5>

                <h3>@Model.PurchaseInvoicesCount</h3>

            </div>
        </div>
    </div>



    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">

                <h5>Total Sales</h5>

                <h3>
                    @Model.TotalSales.ToString("N2")
                </h3>

            </div>
        </div>
    </div>



    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">

                <h5>Total Purchases</h5>

                <h3>
                    @Model.TotalPurchases.ToString("N2")
                </h3>

            </div>
        </div>
    </div>



    <div class="col-md-3 mb-3">
        <div class="card text-center">
            <div class="card-body">

                <h5>Stock Value</h5>

                <h3>
                    @Model.StockValue.ToString("N2")
                </h3>

            </div>
        </div>
    </div>


</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<canvas id="salesPurchaseChart"></canvas>


<script>

var ctx = document.getElementById('salesPurchaseChart');


new Chart(ctx, {

    type: 'bar',

    data: {

        labels: @Html.Raw(Json.Serialize(Model.Months)),


        datasets: [

        {
            label: 'Sales',

            data: @Html.Raw(Json.Serialize(Model.SalesData))

        },


        {
            label: 'Purchases',

            data: @Html.Raw(Json.Serialize(Model.PurchasesData))

        }

        ]

    },


    options: {

        responsive: true

    }

});

</script>

<!-- Low Stock Alert -->
<div class="card mt-4">
    <div class="card-header bg-danger text-white">
        <h5 class="mb-0">Low Stock Alert</h5>
    </div>

    <div class="card-body">

        @if (Model.LowStockProducts.Any())
        {
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Quantity</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.LowStockProducts)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td class="text-danger fw-bold">@item.Quantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-success mb-0">
                No low stock products.
            </div>
        }

    </div>
</div>