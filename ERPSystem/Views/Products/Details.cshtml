@model ERPSystem.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h2 class="mb-4">Product Details</h2>

<div class="card shadow">
    <div class="card-body">

        <div class="row">

            <div class="col-md-4 text-center">

                @if (!string.IsNullOrEmpty(Model.imagesrc))
                {
                    <img src="@Model.imagesrc"
                         class="img-thumbnail"
                         width="220" />
                }
                else
                {
                    <div class="text-muted">
                        No Image
                    </div>
                }

            </div>

            <div class="col-md-8">

                <dl class="row">

                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Code</dt>
                    <dd class="col-sm-8">@Model.Code</dd>

                    <dt class="col-sm-4">Barcode</dt>
                    <dd class="col-sm-8">@Model.Barcode</dd>

                    <dt class="col-sm-4">Purchase Price</dt>
                    <dd class="col-sm-8">@Model.PurchasePrice.ToString("0.00")</dd>

                    <dt class="col-sm-4">Sale Price</dt>
                    <dd class="col-sm-8">@Model.SalePrice.ToString("0.00")</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.Category?.Name</dd>

                    <dt class="col-sm-4">Unit</dt>
                    <dd class="col-sm-8">@Model.Unit?.Name</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </dd>

                    <dt class="col-sm-4">Created Date</dt>
                    <dd class="col-sm-8">
                        @Model.CreatedDate.ToString("dd/MM/yyyy")
                    </dd>

                </dl>

            </div>

        </div>

    </div>
</div>

<div class="mt-3">

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</div>