@model ERPSystem.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<h2 class="text-danger mb-4">Delete Product</h2>

<div class="alert alert-warning">
    <strong>Warning!</strong> Are you sure you want to delete this product?
</div>

<div class="card">
    <div class="card-body">

        <div class="row">

            <div class="col-md-4 text-center">

                @if (!string.IsNullOrEmpty(Model.imagesrc))
                {
                    <img src="@Model.imagesrc"
                         class="img-thumbnail"
                         width="200" />
                }
                else
                {
                    <p>No Image</p>
                }

            </div>

            <div class="col-md-8">

                <dl class="row">

                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">Code</dt>
                    <dd class="col-sm-8">@Model.Code</dd>

                    <dt class="col-sm-4">Barcode</dt>
                    <dd class="col-sm-8">@Model.Barcode</dd>

                    <dt class="col-sm-4">Purchase Price</dt>
                    <dd class="col-sm-8">@Model.PurchasePrice</dd>

                    <dt class="col-sm-4">Sale Price</dt>
                    <dd class="col-sm-8">@Model.SalePrice</dd>

                    <dt class="col-sm-4">Category</dt>
                    <dd class="col-sm-8">@Model.Category?.Name</dd>

                    <dt class="col-sm-4">Unit</dt>
                    <dd class="col-sm-8">@Model.Unit?.Name</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </dd>

                    <dt class="col-sm-4">Created Date</dt>
                    <dd class="col-sm-8">
                        @Model.CreatedDate.ToString("dd/MM/yyyy")
                    </dd>

                </dl>

            </div>

        </div>

    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">

    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>