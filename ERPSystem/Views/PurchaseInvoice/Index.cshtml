@model IEnumerable<ERPSystem.Models.PurchaseInvoice>

@{
    ViewData["Title"] = "Purchase Invoices";
}

<h2>Purchase Invoices</h2>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        Create New Invoice
    </a>
</div>


<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Invoice Number</th>
            <th>Date</th>
            <th>Supplier</th>
            <th>Warehouse</th>
            <th>Total Amount</th>
            <th>Actions</th>
        </tr>
    </thead>


    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>
                    @item.InvoiceNumber
                </td>

                <td>
                    @item.InvoiceDate.ToShortDateString()
                </td>

                <td>
                    @item.Supplier?.Name
                </td>

                <td>
                    @item.Warehouse?.Name
                </td>

                <td>
                    @item.TotalAmount
                </td>


                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Details
                    </a>


                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>


                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-danger btn-sm">
                        Delete
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>