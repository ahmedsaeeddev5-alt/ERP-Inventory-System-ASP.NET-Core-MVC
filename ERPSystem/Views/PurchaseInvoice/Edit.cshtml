@model ERPSystem.ViewModels.PurchaseInvoiceVM

@{
    ViewData["Title"] = "Edit Purchase Invoice";
}

<h2>Edit Purchase Invoice</h2>


<form asp-action="Edit" method="post">

    <div class="row">

        <div class="col-md-4">

            <label>Invoice Number</label>

            <input asp-for="InvoiceNumber" class="form-control" />

            <span asp-validation-for="InvoiceNumber"
                  class="text-danger"></span>

        </div>


        <div class="col-md-4">

            <label>Invoice Date</label>

            <input asp-for="InvoiceDate"
                   type="date"
                   class="form-control" />

        </div>


        <div class="col-md-4">

            <label>Supplier</label>

            <select asp-for="SupplierId"
                    asp-items="ViewBag.Suppliers"
                    class="form-control">

                <option value="">-- Select Supplier --</option>

            </select>

        </div>


        <div class="col-md-4 mt-3">

            <label>Warehouse</label>

            <select asp-for="WarehouseId"
                    asp-items="ViewBag.Warehouses"
                    class="form-control">

                <option value="">-- Select Warehouse --</option>

            </select>

        </div>

    </div>


    <hr />


    <h4>Products</h4>


    <table class="table table-bordered">

        <thead>

            <tr>

                <th>Product</th>

                <th>Quantity</th>

                <th>Price</th>

                <th>Total</th>

                <th></th>

            </tr>

        </thead>


        <tbody id="itemsBody">


        @for (int i = 0; i < Model.Items.Count; i++)
        {

            <tr>


                <td>

                    <select asp-for="Items[i].ProductId"
                            asp-items="ViewBag.Products"
                            class="form-control">

                    </select>

                </td>


                <td>

                    <input asp-for="Items[i].Quantity"
                           class="form-control quantity"
                           step="0.01"
                           onchange="calculateRow(this)" />

                </td>


                <td>

                    <input asp-for="Items[i].Price"
                           class="form-control price"
                           step="0.01"
                           onchange="calculateRow(this)" />

                </td>


                <td class="rowTotal">

                    @(Model.Items[i].Quantity * Model.Items[i].Price)

                </td>


                <td>

                    <button type="button"
                            class="btn btn-danger"
                            onclick="removeRow(this)">

                        Remove

                    </button>

                </td>


            </tr>

        }


        </tbody>


    </table>


    <button type="button"
            class="btn btn-success"
            onclick="addItem()">

        Add Product

    </button>


    <hr />


    <button type="submit"
            class="btn btn-primary">

        Save Changes

    </button>


    <a asp-action="Index"
       class="btn btn-secondary">

        Back

    </a>


</form>



@section Scripts {

<partial name="_ValidationScriptsPartial" />


<script>

let index = @Model.Items.Count;


function addItem()
{

    let row = `

    <tr>

        <td>

            <select name="Items[${index}].ProductId"
                    class="form-control">

                @foreach(var item in ViewBag.Products)
                {
                    <option value="@item.Value">
                        @item.Text
                    </option>
                }

            </select>

        </td>


        <td>

            <input name="Items[${index}].Quantity"
                   class="form-control quantity"
                   type="number"
                   step="0.01"
                   onchange="calculateRow(this)" />

        </td>


        <td>

            <input name="Items[${index}].Price"
                   class="form-control price"
                   type="number"
                   step="0.01"
                   onchange="calculateRow(this)" />

        </td>


        <td class="rowTotal">
            0
        </td>


        <td>

            <button type="button"
                    class="btn btn-danger"
                    onclick="removeRow(this)">

                Remove

            </button>

        </td>


    </tr>`;


    document
        .getElementById("itemsBody")
        .insertAdjacentHTML('beforeend', row);


    index++;

}



function removeRow(button)
{
    button.closest("tr").remove();
}



function calculateRow(input)
{

    let row = input.closest("tr");


    let qty =
        row.querySelector(".quantity").value;


    let price =
        row.querySelector(".price").value;


    row.querySelector(".rowTotal").innerHTML =
        qty * price;

}


</script>

}