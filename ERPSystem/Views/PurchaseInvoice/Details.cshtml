@model ERPSystem.Models.PurchaseInvoice

@{
    ViewData["Title"] = "Purchase Invoice Details";
}

<h2>Purchase Invoice Details</h2>


<div class="card mb-3">

    <div class="card-body">

        <div class="row">

            <div class="col-md-4">
                <strong>Invoice Number:</strong>
                @Model.InvoiceNumber
            </div>


            <div class="col-md-4">
                <strong>Date:</strong>
                @Model.InvoiceDate.ToShortDateString()
            </div>


            <div class="col-md-4">
                <strong>Supplier:</strong>
                @Model.Supplier?.Name
            </div>


            <div class="col-md-4 mt-2">
                <strong>Warehouse:</strong>
                @Model.Warehouse?.Name
            </div>

        </div>

    </div>

</div>



<h4>Products</h4>


<table class="table table-bordered table-striped">

    <thead>

        <tr>

            <th>Product</th>

            <th>Quantity</th>

            <th>Price</th>

            <th>Total</th>

        </tr>

    </thead>


    <tbody>

        @foreach (var item in Model.Items)
        {
            <tr>

                <td>
                    @item.Product?.Name
                </td>


                <td>
                    @item.Quantity
                </td>


                <td>
                    @item.Price
                </td>


                <td>
                    @item.Total
                </td>

            </tr>
        }

    </tbody>


</table>



<div class="text-end">

    <h4>
        Total Amount:
        @Model.TotalAmount
    </h4>

</div>


<div class="mt-3">

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-warning">
        Edit
    </a>


    <a asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>

</div>