@model ERPSystem.Models.PurchaseInvoice

@{
    ViewData["Title"] = "Delete Purchase Invoice";
}

<h2>Delete Purchase Invoice</h2>


<div class="alert alert-danger">

    <h4>
        Are you sure you want to delete this invoice?
    </h4>

</div>



<div class="card">

    <div class="card-body">


        <div class="row">


            <div class="col-md-4">

                <strong>
                    Invoice Number:
                </strong>

                @Model.InvoiceNumber

            </div>


            <div class="col-md-4">

                <strong>
                    Date:
                </strong>

                @Model.InvoiceDate.ToShortDateString()

            </div>


            <div class="col-md-4">

                <strong>
                    Supplier:
                </strong>

                @Model.Supplier?.Name

            </div>


            <div class="col-md-4 mt-2">

                <strong>
                    Warehouse:
                </strong>

                @Model.Warehouse?.Name

            </div>


            <div class="col-md-4 mt-2">

                <strong>
                    Total Amount:
                </strong>

                @Model.TotalAmount

            </div>


        </div>


    </div>

</div>


<hr />


<h4>Products</h4>


<table class="table table-bordered">


    <thead>

        <tr>

            <th>
                Product
            </th>

            <th>
                Quantity
            </th>

            <th>
                Price
            </th>

            <th>
                Total
            </th>

        </tr>

    </thead>


    <tbody>

        @foreach (var item in Model.Items)
        {
            <tr>

                <td>
                    @item.Product?.Name
                </td>


                <td>
                    @item.Quantity
                </td>


                <td>
                    @item.Price
                </td>


                <td>
                    @item.Total
                </td>

            </tr>
        }


    </tbody>


</table>



<form asp-action="Delete" method="post">

    <input type="hidden" asp-for="Id" />


    <button type="submit"
            class="btn btn-danger">

        Delete

    </button>


    <a asp-action="Index"
       class="btn btn-secondary">

        Cancel

    </a>


</form>